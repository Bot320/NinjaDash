# Copy to config/.env (gitignored) and chmod 600.
# NinjaOne → Administration → Apps → API → Client app IDs → Add
#   Application platform: API Services (machine-to-machine)
#   Scopes: Monitoring (read-only)   Grant type: Client Credentials

# Region host: app.ninjarmm.com (US), eu.ninjarmm.com, ca.ninjarmm.com, oc.ninjarmm.com, us2.ninjarmm.com
NINJA_HOST=eu.ninjarmm.com
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=

# Polling (seconds)
POLL_FAST=60        # alerts, device online state
POLL_SLOW=600       # patches, antivirus, backups

# Backend
LISTEN=127.0.0.1:8080
HISTORY_DB=/var/lib/ninjadash/history.sqlite

# Display
THEME=auto          # dark | light | auto (light 07:00-19:00)
PATCH_TARGET=90
