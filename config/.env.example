# NinjaDash settings. The real file is NOT in this repo:
#   on the mini PC:        /etc/ninjadash/ninjadash.env     (edit with: sudo ninjadash edit)
#   on a development PC:   ~/.config/ninjadash/ninjadash.env
#
# Create the API client in NinjaOne (https://eu.ninjarmm.com):
#   Administration → Apps → API → Client App IDs → Add
#     Application platform: API Services (machine-to-machine)
#     Name:                 NinjaDash
#     Scopes:               Monitoring          (read-only; nothing else)
#     Allowed grant types:  Client Credentials
#   Save. NinjaOne shows the Client ID and the Client Secret; the secret is shown ONCE, so copy it right away.
# While the two values below are empty, the dashboard shows example data.

NINJA_HOST=eu.ninjarmm.com
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=

# How often to ask NinjaOne for new data (seconds)
POLL_FAST=60        # alerts, online state
POLL_SLOW=300       # antivirus, backup jobs

# Where the dashboard listens. Use 0.0.0.0:8080 to also open it from other PCs on the network.
LISTEN=127.0.0.1:8080

# Colours: dark | light | auto (light between LIGHT_FROM and LIGHT_UNTIL)
THEME=auto
LIGHT_FROM=07:00
LIGHT_UNTIL=19:00

# Optional: where the 14-day history is kept (default /var/lib/ninjadash/history.sqlite)
# HISTORY_DB=/var/lib/ninjadash/history.sqlite
