# NinjaDash settings. The real file is NOT in this repo:
#   on the mini PC:        /etc/ninjadash/ninjadash.env     (root:ninjadash, chmod 640)
#   on a development PC:   ~/.config/ninjadash/ninjadash.env (chmod 600)
# The backend reads NINJADASH_ENV if set, otherwise the first of those two that exists.
#
# Create the API client in NinjaOne (https://eu.ninjarmm.com):
#   Administration → Apps → API → Client App IDs → Add
#     Application platform: API Services (machine-to-machine)
#     Name:                 NinjaDash
#     Scopes:               Monitoring          (read-only; nothing else)
#     Allowed grant types:  Client Credentials
#   Save. NinjaOne shows the Client ID and the Client Secret; the secret is shown ONCE, so copy it right away.

NINJA_HOST=eu.ninjarmm.com
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=

# Polling (seconds)
POLL_FAST=60        # alerts, online state
POLL_SLOW=300       # antivirus, RAID, backup

# Backend
LISTEN=127.0.0.1:8080
HISTORY_DB=/var/lib/ninjadash/history.sqlite

# Display
THEME=auto          # dark | light | auto (light 07:00-19:00)
LIGHT_FROM=07:00
LIGHT_UNTIL=19:00
