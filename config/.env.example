# NinjaDash settings. The real file is NOT in this repo:
#   on the mini PC:        /etc/ninjadash/ninjadash.env     (edit with: sudo ninjadash edit)
#   on a development PC:   ~/.config/ninjadash/ninjadash.env
#
# Create the API client in NinjaOne (https://eu.ninjarmm.com):
#   Administration → Apps → API → Client App IDs → Add
#     Application platform: API Services (machine-to-machine)
#     Name:                 NinjaDash
#     Scopes:               Monitoring          (read-only; nothing else)
#     Allowed grant types:  Client Credentials
#   Save. NinjaOne shows the Client ID and the Client Secret; the secret is shown ONCE, so copy it right away.
# While the two values below are empty, the dashboard shows example data.

NINJA_HOST=eu.ninjarmm.com
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=

# How often to ask NinjaOne for new data (seconds)
POLL_FAST=60        # alerts, online state
POLL_SLOW=300       # antivirus, backup jobs

# Where the dashboard listens. 127.0.0.1 = this PC only. 0.0.0.0 = also reachable from the network,
# which Home Assistant needs (install.sh --home-assistant sets this for you).
LISTEN=127.0.0.1:8080

# What other computers may use when LISTEN is 0.0.0.0:
#   screen = only the screen on/off switch (needs SCREEN_TOKEN)   all = also view the dashboard   none = nothing
REMOTE_ACCESS=screen
# Secret for switching the screen from Home Assistant (install.sh creates one). Show it: sudo ninjadash home-assistant
SCREEN_TOKEN=

# Colours: dark | light | auto (light between LIGHT_FROM and LIGHT_UNTIL)
THEME=auto
LIGHT_FROM=07:00
LIGHT_UNTIL=19:00

# Screen schedule without Home Assistant (empty = no schedule). Easiest: sudo ninjadash schedule set 07:00 19:00 mon-fri
#   SCREEN_DAYS: mon-fri, mon,wed,fri, weekdays, daily (German mo-fr works too). Other days the screen stays off.
#   SCREEN_OFF_DATES: extra days off, e.g. 2026-12-24,2026-12-25 or 2026-12-24..2027-01-01
SCREEN_ON=
SCREEN_OFF=
SCREEN_DAYS=mon-fri
SCREEN_OFF_DATES=

# Devices (servers and PCs) that have been offline for more than this many days are left out of the
# warnings and Low storage. The Servers card says how many are hidden. 0 = show every device.
HIDE_OFFLINE_DAYS=30

# Optional: where the 14-day history is kept (default /var/lib/ninjadash/history.sqlite)
# HISTORY_DB=/var/lib/ninjadash/history.sqlite
